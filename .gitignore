# ==============================================================
#  Smart Event Hub — .gitignore
# ==============================================================

# 🛑 Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
.env
.env.*
*.env
!*.env.example
*.pem
*.key
*.cert
credentials.json
token.json
token.pickle

# 📦 Executables & Binaries
cloudflared.exe
*.exe
*.dll
*.bin

# 🗄️ Database Files & Volumes
*.db
*.sqlite
*.sqlite3
eventhub.db
backend/eventhub.db
pgdata/

# 📜 Logs & Runtime Artifacts
*.log
backend_err.log
backend_out.log
frontend_err.log
frontend_out.log
tunnel.log
PUBLIC_URL.txt

# 📂 User Uploads & Temporary Media
uploads/
backend/uploads/
backend/uploads/*
!backend/uploads/.gitkeep

# 🐍 Python Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# ⚛️ Frontend Artifacts & Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 💻 IDE & OS Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 🤖 Agent Local State
.gemini/
.system_generated/
